# Vercel Environment Variables
# Set these in the Vercel project for Production/Preview/Development.
# SUPABASE_URL is safe-ish but keep env-managed for portability.
# SUPABASE_SERVICE_ROLE_KEY is secret. Never expose it in browser JS or commit a real value.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
